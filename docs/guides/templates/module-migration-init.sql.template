-- Template migrație Prisma: tabela principală + outbox_events
-- Validat prin E10 (2026-10-25). Înlocuiește <TABLE> și adaugă câmpuri specifice.
--
-- Convenție: camelCase pentru numele coloanelor (consistenți cu lab_booking, lab_crm)
-- RLS se adaugă în scriptul de migrate-deploy, nu în migration.sql

-- CreateTable
CREATE TABLE "<TABLE>" (
    "id" TEXT NOT NULL,
    "organizationId" TEXT NOT NULL,
    "name" TEXT NOT NULL,
    -- ... câmpuri specifice modulului
    "createdAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT "<TABLE>_pkey" PRIMARY KEY ("id")
);

-- Outbox (Lot 4.1): nu se mai scrie de mână. Migrarea-șablon (outbox_events +
-- processed_events, RLS, funcțiile outbox_pending și outbox_dead_letters) o generează
-- outboxMigrationSql("<schema>", "<rol_modul>") din @ventora/db-kit; rezultatul se lipește într-o
-- migrare versionată separată (<data>_outbox_init/migration.sql), doar pentru schemele care emit.
