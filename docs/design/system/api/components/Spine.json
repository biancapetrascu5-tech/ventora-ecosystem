   "note": ""
  },
  {
   "name": "hub",
   "type": "boolean",
   "required": false,
   "note": ""
  },
  {
   "name": "appName",
   "type": "string",
   "required": false,
   "note": ""
  },
  {
   "name": "appIcon",
   "type": "string",
   "required": false,
   "note": ""
  },
  {
   "name": "sections",
   "type": "{ label?: string; items: NavItem[]; }[]",
   "required": true,
   "note": ""
  },
  {
   "name": "activeId",
   "type": "string",
   "required": false,
   "note": ""
  },
  {
   "name": "onNavigate",
   "type": "(item: NavItem) => void",
   "required": false,
   "note": ""
  },
  {
   "name": "onBackToHub",
