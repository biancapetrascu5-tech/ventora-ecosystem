   "type": "boolean",
   "required": false,
   "note": ""
  },
  {
   "name": "onCollapsedChange",
   "type": "(c: boolean) => void",
   "required": false,
   "note": ""
  },
  {
   "name": "bottomItems",
   "type": "string[]",
   "required": false,
   "note": ""
  }
 ],
 "events": [
