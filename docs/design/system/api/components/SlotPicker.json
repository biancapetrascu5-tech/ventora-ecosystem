{
 "name": "SlotPicker",
 "version": "1.0.1",
 "kind": "component",
 "group": "Forms",
 "status": "changed",
 "description": "Free start times for a service and a person, as a grid of buttons; taken times stay visible, disabled and struck through, so people understand the day.",
