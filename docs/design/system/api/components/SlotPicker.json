   "type": "{ time: string; available?: boolean; }[]",
   "required": true,
   "note": ""
  },
  {
   "name": "value",
   "type": "string",
   "required": false,
   "note": ""
  },
  {
   "name": "onChange",
   "type": "(time: string) => void",
   "required": false,
   "note": ""
  },
  {
   "name": "label",
   "type": "string",
   "required": false,
   "note": ""
  }
 ],
 "events": [
  "onChange"
 ],
 "states": [
  "available",
  "taken",
  "selected",
  "none-selected",
  "fully-booked"
 ],
 "notes": "",
 "readme": "components/SlotPicker/README.md",
 "preview": "components/SlotPicker/preview.html"
}