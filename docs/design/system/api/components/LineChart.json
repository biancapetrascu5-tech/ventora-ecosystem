   "type": "number",
   "required": false,
   "note": ""
  },
  {
   "name": "nowLabel",
   "type": "string",
   "required": false,
   "note": ""
  },
  {
   "name": "title",
   "type": "string",
   "required": true,
   "note": ""
  },
  {
   "name": "description",
   "type": "string",
   "required": false,
   "note": ""
  },
  {
   "name": "unit",
   "type": "string",
   "required": false,
   "note": ""
  },
  {
