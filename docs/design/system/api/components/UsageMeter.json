{
 "name": "UsageMeter",
 "version": "1.0.1",
 "kind": "component",
 "group": "Feedback",
 "status": "changed",
 "description": "Consumption against a subscription limit, shown calmly: what is used, what is left, a warning near the limit and a controlled block at the limit. It never uses red and nothing is lost: only the next new item pauses. The words come from the glossary: \"abonament\", \"pachet în plus\", \"Cere alt abonament\" — never \"plan\".",
 "exports": [
  "UsageMeter"
 ],
 "props": [
  {
   "name": "label",
   "type": "string",
   "required": true,
   "note": ""
  },
  {
   "name": "used",
   "type": "number",
   "required": true,
   "note": ""
  },
  {
   "name": "limit",
   "type": "number",
   "required": false,
   "note": ""
  },
  {
   "name": "unit",
   "type": "string",
   "required": false,
   "note": ""
  },
  {
   "name": "warnAt",
   "type": "number",
   "required": false,
   "note": ""
  },
  {
   "name": "onUpgrade",
   "type": "() => void",
   "required": false,
   "note": ""
  },
  {
   "name": "onBuy",
   "type": "() => void",
   "required": false,
   "note": ""
  },
  {
   "name": "buyLabel",
   "type": "string",
   "required": false,
   "note": ""
  },
  {
   "name": "owner",
   "type": "string",
   "required": false,
   "note": ""
  },
  {
   "name": "onNotifyOwner",
   "type": "() => void",
   "required": false,
   "note": ""
  },
  {
   "name": "compact",
   "type": "boolean",
   "required": false,
   "note": ""
  },
  {
   "name": "format",
   "type": "(n: number) => string",
   "required": false,
   "note": ""
  }
 ],
 "events": [
  "onBuy",
  "onNotifyOwner",
  "onUpgrade"
 ],
 "states": [
  "ok",
  "warn-owner",
  "warn-member",
  "limit-owner",
  "limit-member",
  "unlimited",
  "with-unit",
  "compact-warn",
  "compact-limit"
 ],
 "notes": "",
