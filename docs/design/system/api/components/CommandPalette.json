   "required": false,
   "note": ""
  },
  {
   "name": "groups",
   "type": "{ label: string; items: CommandItem[]; }[]",
   "required": true,
   "note": ""
  },
  {
   "name": "placeholder",
   "type": "string",
   "required": false,
   "note": ""
  },
  {
   "name": "onQueryChange",
   "type": "(q: string) => void",
   "required": false,
   "note": ""
  },
  {
   "name": "loading",
   "type": "boolean",
   "required": false,
   "note": ""
  },
  {
   "name": "inline",
   "type": "boolean",
   "required": false,
   "note": ""
