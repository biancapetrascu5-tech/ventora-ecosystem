# Completați .env.local cu valorile reale. Nu adăugați valori în acest fișier.

# Observabilitate (Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# URL-uri aplicații (locale sau deployment)
# În production, PLATFORM și FOUNDER sunt obligatorii: sunt baza linkurilor din e-mailuri.
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3100
NEXT_PUBLIC_PORTAL_URL=http://localhost:3101
NEXT_PUBLIC_FOUNDER_URL=http://localhost:3102

# -----------------------------------------------------------------------
# Baze de date — core/identity
# Convenție: DATABASE_URL = identity (Hub), DATABASE_URL_FOUNDER = founder.
# DIRECT_URL = conexiunea directă folosită DOAR la migrări (session pooler
# port 5432). Aplicația NU citește DIRECT_URL la runtime.
# Documentație: docs/ARCHITECTURE.md §6.2
# -----------------------------------------------------------------------

# Runtime identity — transaction pooler (port 6543)
# Format: postgresql://app_runtime.<ref>:<parola>@<host>:6543/postgres?pgbouncer=true
DATABASE_URL=

# Runtime founder — transaction pooler (port 6543)
# Format: postgresql://founder_runtime.<ref>:<parola>@<host>:6543/postgres?pgbouncer=true
DATABASE_URL_FOUNDER=

# Migrări — session pooler (port 5432, doar pentru prisma migrate deploy)
DIRECT_URL=

# Autentificare Better Auth
BETTER_AUTH_SECRET=
FOUNDER_AUTH_SECRET=

# Mediul de deployment: staging | production (doar când NODE_ENV=production)
APP_ENV=

# Email (Resend), domeniul ventora-hub.com
# - development / test: dacă lipsește cheia, e-mailurile apar doar în consolă (fără corp)
# - production: cheia e obligatorie; doar cu APP_ENV=staging aplicația pornește fără ea,
#   iar fiecare e-mail e marcat „failed” și auditat
RESEND_API_KEY=
# Opționale; implicit: Ventora Systems <noreply@ventora-hub.com> și support@ventorasystems.com
EMAIL_FROM=
EMAIL_REPLY_TO=

# Serviciul de job-uri (Inngest, Lot 4.2). Local nu trebuie: clientul folosește serverul de
# dezvoltare (inngest-cli dev). Cheile vin din contul Inngest, doar aici și în Vercel. În production
# `platform` nu pornește fără ele (Lotul 4.11); `founder` și `portal` nu le folosesc.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Fișierele (Lot 4.7, D4-16: Supabase Storage, regiunea UE). Doar pe server: niciodată NEXT_PUBLIC_.
# SUPABASE_URL = URL-ul proiectului; SUPABASE_SERVICE_ROLE_KEY = cheia de serviciu (Settings → API);
# FILES_BUCKET = bucket-ul privat al mediului, creat de fondatoare (raportul Lotului 4.7).
# FILES_LINK_SECRET = cheia linkurilor de descărcare (cel puțin 32 de caractere, aleatoare).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FILES_BUCKET=
FILES_LINK_SECRET=

# Plățile cu cardul (Stripe, Lot 3.5): cheile de TEST până la lansare, doar în .env.local și în
# Vercel. Local, secretul webhook-ului îl dă `stripe listen --forward-to localhost:3100/api/webhooks/stripe`.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Alertele pentru echipa Ventora (disputele Stripe, Lotul 3.6): adresa care le primește.
FOUNDER_ALERTS_EMAIL=

# Facturile (SmartBill, Lotul 3.6): contul de TEST („Test SRL”, seria TST, neconectat la SPV) până
# la lansare; doar în .env.local și în Vercel. Fără ele nu se emite nimic (facturile rămân pending).
SMARTBILL_USER=
SMARTBILL_TOKEN=
SMARTBILL_CIF=
SMARTBILL_SERIES=
# Opționale. Mențiunea de TVA de pe factură (implicit: propunerea din core/billing/src/smartbill.ts,
# DE CONFIRMAT CU CONTABILUL), unitatea de măsură din cont (implicit „buc”) și, doar dacă o cere
# contabilul, cota de TVA trimisă pe linii (nume + procent, ex. SDD / 0).
SMARTBILL_VAT_MENTION=
SMARTBILL_MEASURING_UNIT=
SMARTBILL_TAX_NAME=
SMARTBILL_TAX_PERCENTAGE=
# Încasarea unei facturi de transfer și în SmartBill (Lotul 3.8, N16; validată pe contul de test
# în 3.9a, E7): `1` o pornește. Nesetată: încasarea rămâne doar în Ventora și se reîncearcă.
SMARTBILL_RECORD_PAYMENTS=

# Rezervarea publică EasyBook (Lotul B.11a, D-B-6): cheia secretă Cloudflare Turnstile, verificată
# pe server. O pune Bianca la staging și producție, doar în .env.local și în Vercel; nu se scrie
# niciodată în cod sau în commit. Nesetată: nicio rezervare publică nu trece de verificare.
TURNSTILE_SECRET_KEY=
# Cheia publică a site-ului Turnstile (widgetul din pagina publică, ecranul 6). E publică, dar o pune
# tot fondatoarea, doar în Vercel; nesetată: widgetul nu apare și nicio rezervare nu trece.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
