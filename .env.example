# Completați .env.local cu valorile reale. Nu adăugați valori în acest fișier.

# Observabilitate (Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# URL-uri aplicații (locale sau deployment)
# În production, PLATFORM și FOUNDER sunt obligatorii: sunt baza linkurilor din e-mailuri.
NEXT_PUBLIC_PLATFORM_URL=http://localhost:3100
NEXT_PUBLIC_PORTAL_URL=http://localhost:3101
NEXT_PUBLIC_FOUNDER_URL=http://localhost:3102

# -----------------------------------------------------------------------
# Baze de date — core/identity
# Convenție: DATABASE_URL = identity (Hub), DATABASE_URL_FOUNDER = founder.
# DIRECT_URL = conexiunea directă folosită DOAR la migrări (session pooler
# port 5432). Aplicația NU citește DIRECT_URL la runtime.
# Documentație: docs/ARCHITECTURE.md §6.2
# -----------------------------------------------------------------------

# Runtime identity — transaction pooler (port 6543)
# Format: postgresql://app_runtime.<ref>:<parola>@<host>:6543/postgres?pgbouncer=true
DATABASE_URL=

# Runtime founder — transaction pooler (port 6543)
# Format: postgresql://founder_runtime.<ref>:<parola>@<host>:6543/postgres?pgbouncer=true
DATABASE_URL_FOUNDER=

# Migrări — session pooler (port 5432, doar pentru prisma migrate deploy)
DIRECT_URL=

# Autentificare Better Auth
BETTER_AUTH_SECRET=
FOUNDER_AUTH_SECRET=

# Mediul de deployment: staging | production (doar când NODE_ENV=production)
APP_ENV=

# Email (Resend), domeniul ventora-hub.com
# - development / test: dacă lipsește cheia, e-mailurile apar doar în consolă (fără corp)
# - production: cheia e obligatorie; doar cu APP_ENV=staging aplicația pornește fără ea,
#   iar fiecare e-mail e marcat „failed” și auditat
RESEND_API_KEY=
# Opționale; implicit: Ventora <noreply@ventora-hub.com> și support@ventorasystems.com
EMAIL_FROM=
EMAIL_REPLY_TO=
