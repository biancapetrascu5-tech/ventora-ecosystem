# E4-vercel — format variabile de mediu
# Copiezi asta în .env.local și completezi valorile reale (niciodată în repo).
# Variabilele de mai jos le adaugi și în Vercel → Settings → Environment Variables,
# cu excepția DATABASE_URL_SUPERUSER care rămâne DOAR local.

# ─── Varianta A: câte un rol per modul (transaction pooler, port 6543) ──────
# Format: postgresql://<ROLE>.<PROJECT-REF>:<PASSWORD>@<POOLER-HOST>:6543/postgres
DATABASE_URL_CORE=postgresql://lab_core_user.<ref>:<PAROLA_CORE>@<POOLER-HOST>:6543/postgres
DATABASE_URL_BOOKING=postgresql://lab_booking_user.<ref>:<PAROLA_BOOKING>@<POOLER-HOST>:6543/postgres
DATABASE_URL_CRM=postgresql://lab_crm_user.<ref>:<PAROLA_CRM>@<POOLER-HOST>:6543/postgres

# ─── Varianta B: rol cu acces la toate schemele (transaction pooler, port 6543) ─
DATABASE_URL_MULTI=postgresql://lab_multi_user.<ref>:<PAROLA_MULTI>@<POOLER-HOST>:6543/postgres

# ─── Migrate + seed (session pooler, port 5432) — DOAR local, nu pe Vercel ──
# Format: postgresql://postgres.<PROJECT-REF>:<PASSWORD>@<POOLER-HOST>:5432/postgres
DATABASE_URL_SUPERUSER=postgresql://postgres.<ref>:<PAROLA_POSTGRES>@<POOLER-HOST>:5432/postgres
