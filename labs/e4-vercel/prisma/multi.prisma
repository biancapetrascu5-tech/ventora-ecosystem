generator client {
  provider        = "prisma-client-js"
  output          = "../generated/multi-client"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["lab_core", "lab_booking", "lab_crm"]
}

// ─── lab_core ─────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  @@map("organizations")
  @@schema("lab_core")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())

  @@map("users")
  @@schema("lab_core")
}

model Membership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member")
  createdAt      DateTime @default(now())

  @@unique([organizationId, userId])
  @@map("memberships")
  @@schema("lab_core")
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  organizationId String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@map("sessions")
  @@schema("lab_core")
}

model UsageCounter {
  id             String   @id @default(cuid())
  organizationId String
  metric         String
  count          Int      @default(0)
  reserved       Int      @default(0)
  limit          Int      @default(100)
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, metric])
  @@map("usage_counters")
  @@schema("lab_core")
}

model QuotaReservation {
  id             String    @id @default(cuid())
  organizationId String
  metric         String
  amount         Int
  operationId    String    @unique
  status         String    @default("reserved")
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  @@map("quota_reservations")
  @@schema("lab_core")
}

// ─── lab_booking ──────────────────────────────────────────────────────────────

model OutboxEvent {
  id          String    @id
  eventType   String
  payload     Json
  processedAt DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@map("outbox_events")
  @@schema("lab_booking")
}

model Service {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  durationMinutes Int
  createdAt       DateTime @default(now())

  @@map("services")
  @@schema("lab_booking")
}

model Appointment {
  id             String   @id @default(cuid())
  organizationId String
  serviceId      String
  contactId      String
  staffMemberId  String?
  scheduledAt    DateTime
  status         String   @default("pending")
  createdAt      DateTime @default(now())

  @@map("appointments")
  @@schema("lab_booking")
}

// ─── lab_crm ──────────────────────────────────────────────────────────────────

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  createdAt      DateTime @default(now())

  @@map("contacts")
  @@schema("lab_crm")
}
