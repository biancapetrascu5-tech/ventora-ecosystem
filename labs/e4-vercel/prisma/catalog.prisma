generator client {
  provider        = "prisma-client-js"
  output          = "../generated/catalog-client"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["lab_catalog"]
}

model CatalogItem {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@map("catalog_items")
  @@schema("lab_catalog")
}

model CatalogOutboxEvent {
  id          String    @id
  eventType   String
  payload     Json
  processedAt DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@map("outbox_events")
  @@schema("lab_catalog")
}
