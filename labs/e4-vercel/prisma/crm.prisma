generator client {
  provider        = "prisma-client-js"
  output          = "../generated/crm-client"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["lab_crm"]
}

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  createdAt      DateTime @default(now())

  @@map("contacts")
  @@schema("lab_crm")
}
