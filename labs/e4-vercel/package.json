{
  "name": "e4-vercel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.14.0",
  "scripts": {
    "dev": "next dev -p 3103",
    "build": "pnpm run generate && next build",
    "start": "next start",
    "generate": "prisma generate --config prisma.config.core.ts && prisma generate --config prisma.config.booking.ts && prisma generate --config prisma.config.crm.ts && prisma generate --config prisma.config.multi.ts && prisma generate --config prisma.config.runtime.ts && prisma generate --config prisma.config.auth.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "pnpm run generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/client-runtime-utils": "7.10.1",
    "better-auth": "1.7.12",
    "inngest": "4.26.0",
    "next": "16.4.3",
    "pg": "^8.0.0",
    "prisma": "7.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~6.0.3"
  }
}
