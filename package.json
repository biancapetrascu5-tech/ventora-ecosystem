{
  "name": "ventora-ecosystem",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "tokens:generate": "node packages/tokens/scripts/generate.mjs",
    "i18n:check": "node packages/i18n/scripts/check.mjs",
    "guards:verify": "node scripts/guards-verify.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,json,mjs}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,mjs}\" --ignore-path .prettierignore",
    "founder:bootstrap": "tsx core/identity/scripts/bootstrap-founder.ts",
    "test:db:up": "node scripts/test-db-up.mjs",
    "test:db:down": "node scripts/test-db-down.mjs",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.72.0",
    "eslint-plugin-boundaries": "^7.0.0",
    "eslint-plugin-i18next": "^6.1.0",
    "pg": "^8.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "turbo": "^2.5.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
