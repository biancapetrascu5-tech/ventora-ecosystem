// Schema "booking" (Lot B.1; D-B1-3 = a: modules/booking/prisma/) — folosită pentru garda de drift
// (prisma migrate diff) și prisma migrate deploy. Codul nu folosește un client Prisma generat (ca în
// core/support): rulează pe pg, cu SET LOCAL ROLE booking_rw și app.organization_id.
// CHECK-urile, indecșii unici parțiali pe nume, triggerele, rolul, grant-urile, RLS și funcțiile
// outbox sunt doar în migrare.

datasource db {
  provider = "postgresql"
  schemas  = ["booking"]
}

/// O categorie din catalogul de servicii („Categorii de servicii”).
model ServiceCategory {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  name             String    @db.VarChar(80)
  sortOrder        Int       @default(0) @map("sort_order")
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz
  archivedByUserId String?   @map("archived_by_user_id") @db.Uuid
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  services Service[]

  @@index([organizationId, sortOrder], map: "service_category_organization_id_sort_idx")
  @@map("service_category")
  @@schema("booking")
}

/// Un serviciu: durata (fixă sau variabilă), prețul (fix, „de la”, interval), moneda, capacitatea.
model Service {
  id                 String    @id @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  categoryId         String?   @map("category_id") @db.Uuid
  name               String    @db.VarChar(120)
  description        String?
  durationMinutes    Int       @map("duration_minutes")
  durationMaxMinutes Int?      @map("duration_max_minutes")
  priceKind          String    @default("fixed") @map("price_kind") @db.VarChar(8)
  priceMinor         Int       @map("price_minor")
  priceMaxMinor      Int?      @map("price_max_minor")
  currency           String    @default("RON") @db.Char(3)
  capacity           Int       @default(1)
  bookableOnline     Boolean   @default(true) @map("bookable_online")
  sortOrder          Int       @default(0) @map("sort_order")
  allStaff           Boolean   @default(true) @map("all_staff")
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz
  archivedByUserId   String?   @map("archived_by_user_id") @db.Uuid
  createdByUserId    String    @map("created_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  category     ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "service_category_id_fkey")
  appointments Appointment[]
  resources    ServiceResource[]
  staff        StaffService[]
  staffTerms   StaffServiceTerms[]
  publicHolds  PublicHold[]

  @@index([organizationId, categoryId, sortOrder], map: "service_organization_id_category_sort_idx")
  @@index([categoryId], map: "service_category_id_idx")
  @@map("service")
  @@schema("booking")
}

/// Lot B.2: the business's week (BookingSettings · „Program de lucru”), one interval per day.
model BusinessHours {
  organizationId  String   @map("organization_id") @db.Uuid
  weekday         Int      @db.SmallInt
  isOpen          Boolean  @map("is_open")
  opensAtMin      Int?     @map("opens_at_min") @db.SmallInt
  closesAtMin     Int?     @map("closes_at_min") @db.SmallInt
  updatedByUserId String   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@id([organizationId, weekday])
  @@map("business_hours")
  @@schema("booking")
}

/// Lot B.2: a member of the business in the calendar (D-B-1); display_name = keep_snapshot (§6.4 d).
model StaffMember {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  displayName      String    @map("display_name") @db.VarChar(120)
  scheduleMode     String    @default("business") @map("schedule_mode") @db.VarChar(8)
  bookableOnline   Boolean   @default(true) @map("bookable_online")
  sortOrder        Int       @default(0) @map("sort_order")
  allServices      Boolean   @default(true) @map("all_services")
  // Lot B.10: the location (core/organizations, checked through the contract; no FK across modules)
  locationId       String?   @map("location_id") @db.Uuid
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz
  archivedByUserId String?   @map("archived_by_user_id") @db.Uuid
  createdByUserId  String?   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  weeklyHours  StaffWeeklyHours[]
  dayOverrides StaffDayOverride[]
  timeOff      StaffTimeOff[]
  appointments Appointment[]
  timeBlocks   TimeBlock[]
  services     StaffService[]
  serviceTerms StaffServiceTerms[]
  publicHolds  PublicHold[]

  @@index([organizationId, sortOrder], map: "staff_member_organization_id_sort_idx")
  @@map("staff_member")
  @@schema("booking")
}

/// Lot B.2: the member's own week, at most two intervals a day (D-B2-3 = a).
model StaffWeeklyHours {
  staffMemberId  String   @map("staff_member_id") @db.Uuid
  weekday        Int      @db.SmallInt
  organizationId String   @map("organization_id") @db.Uuid
  isWorking      Boolean  @map("is_working")
  start1Min      Int?     @map("start1_min") @db.SmallInt
  end1Min        Int?     @map("end1_min") @db.SmallInt
  start2Min      Int?     @map("start2_min") @db.SmallInt
  end2Min        Int?     @map("end2_min") @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "staff_weekly_hours_staff_member_id_fkey")

  @@id([staffMemberId, weekday])
  @@index([organizationId], map: "staff_weekly_hours_organization_id_idx")
  @@map("staff_weekly_hours")
  @@schema("booking")
}

/// Lot B.2: one date that replaces the member's week.
model StaffDayOverride {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  staffMemberId    String    @map("staff_member_id") @db.Uuid
  onDate           DateTime  @map("on_date") @db.Date
  isWorking        Boolean   @map("is_working")
  start1Min        Int?      @map("start1_min") @db.SmallInt
  end1Min          Int?      @map("end1_min") @db.SmallInt
  start2Min        Int?      @map("start2_min") @db.SmallInt
  end2Min          Int?      @map("end2_min") @db.SmallInt
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz
  archivedByUserId String?   @map("archived_by_user_id") @db.Uuid
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "staff_day_override_staff_member_id_fkey")

  @@index([staffMemberId, onDate], map: "staff_day_override_staff_date_idx")
  @@map("staff_day_override")
  @@schema("booking")
}

/// Lot B.2: leave, a range of days; the reason only for the owner and the admins (S124).
model StaffTimeOff {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  staffMemberId    String    @map("staff_member_id") @db.Uuid
  startsOn         DateTime  @map("starts_on") @db.Date
  endsOn           DateTime  @map("ends_on") @db.Date
  reason           String?   @db.VarChar(200)
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz
  archivedByUserId String?   @map("archived_by_user_id") @db.Uuid
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "staff_time_off_staff_member_id_fkey")

  @@index([staffMemberId, startsOn], map: "staff_time_off_staff_starts_idx")
  @@map("staff_time_off")
  @@schema("booking")
}

model OutboxEvent {
  eventId        String    @id @map("event_id") @db.Uuid
  type           String    @db.VarChar(128)
  version        Int
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz
  organizationId String    @map("organization_id") @db.Uuid
  sourceApp      String    @map("source_app") @db.VarChar(64)
  resourceId     String    @map("resource_id") @db.VarChar(255)
  correlationId  String?   @map("correlation_id") @db.VarChar(255)
  payload        Json
  status         String    @default("pending") @db.VarChar(16)
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz
  lastError      String?   @map("last_error")
  failedAt       DateTime? @map("failed_at") @db.Timestamptz
  dispatchedAt   DateTime? @map("dispatched_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("outbox_events")
  @@schema("booking")
}

model ProcessedEvent {
  consumer       String   @db.VarChar(128)
  eventId        String   @map("event_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  processedAt    DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@id([consumer, eventId])
  @@map("processed_events")
  @@schema("booking")
}

/// Lot B.4a: the booking rules of the business (D-B4-5); one row, written on the first save.
model Settings {
  organizationId   String   @id @map("organization_id") @db.Uuid
  freeCancelHours  Int      @default(24) @map("free_cancel_hours") @db.SmallInt
  confirmationMode String   @default("auto") @map("confirmation_mode") @db.VarChar(6)
  noticeMin        Int      @default(0) @map("notice_min") @db.SmallInt
  bufferMin        Int      @default(0) @map("buffer_min") @db.SmallInt
  /// B.7b (S139): the behaviour note, off by default
  behaviorNoteEnabled Boolean   @default(false) @map("behavior_note_enabled")
  behaviorNoteNoShows Int       @default(2) @map("behavior_note_no_shows") @db.SmallInt
  behaviorNoteMonths  Int       @default(6) @map("behavior_note_months") @db.SmallInt
  behaviorNoteSince   DateTime? @map("behavior_note_since") @db.Timestamptz
  updatedByUserId  String   @map("updated_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("settings")
  @@schema("booking")
}

/// Lot B.4a: the client of the business, minimal (D-B4-1); B.7 adds the note, the blocked list, GDPR.
model Client {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  name             String    @db.VarChar(120)
  phone            String?   @db.VarChar(16)
  email            String?   @db.VarChar(254)
  locale           String    @default("ro") @db.VarChar(2)
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz
  archivedByUserId String?   @map("archived_by_user_id") @db.Uuid
  createdByUserId  String?   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  /// B.7a (D-B7-2): merged into another client (archived, with a link to the one kept)
  mergedIntoClientId String?   @map("merged_into_client_id") @db.Uuid
  mergedAt           DateTime? @map("merged_at") @db.Timestamptz
  mergedByUserId     String?   @map("merged_by_user_id") @db.Uuid
  /// B.7a (D-B7-1): erased (GDPR), written only by booking.erase_client
  erasedAt           DateTime? @map("erased_at") @db.Timestamptz
  erasedByUserId     String?   @map("erased_by_user_id") @db.Uuid

  appointments Appointment[]
  mergedInto   Client?       @relation("ClientMerge", fields: [mergedIntoClientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "client_merged_into_client_id_fkey")
  mergedFrom   Client[]      @relation("ClientMerge")
  blocks       ClientBlock[]
  noteRemovals ClientNoteRemoval[]
  medicalConsents MedicalConsent[]
  medicalAnswers  MedicalAnswer[]
  payments        AppointmentPayment[]

  @@index([organizationId, name], map: "client_organization_id_name_idx")
  @@index([mergedIntoClientId], map: "client_merged_into_client_id_idx")
  @@map("client")
  @@schema("booking")
}

/// Lot B.4a: the last human number of the business (D-B4-8).
model AppointmentCounter {
  organizationId String @id @map("organization_id") @db.Uuid
  lastNumber     Int    @map("last_number")

  @@map("appointment_counter")
  @@schema("booking")
}

/// Lot B.4a: an appointment and its state (D-B-11, S116); the copies are keep_snapshot (§6.4 d).
model Appointment {
  id                  String    @id @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  number              Int
  staffMemberId       String    @map("staff_member_id") @db.Uuid
  serviceId           String    @map("service_id") @db.Uuid
  clientId            String    @map("client_id") @db.Uuid
  startsAt            DateTime  @map("starts_at") @db.Timestamptz
  endsAt              DateTime  @map("ends_at") @db.Timestamptz
  durationMinutes     Int       @map("duration_minutes") @db.SmallInt
  capacity            Int       @db.SmallInt
  status              String    @db.VarChar(16)
  statusChangedAt     DateTime  @default(now()) @map("status_changed_at") @db.Timestamptz
  serviceName         String    @map("service_name") @db.VarChar(120)
  staffDisplayName    String    @map("staff_display_name") @db.VarChar(120)
  clientName          String    @map("client_name") @db.VarChar(120)
  priceKind           String    @map("price_kind") @db.VarChar(8)
  priceMinor          Int       @map("price_minor")
  priceMaxMinor       Int?      @map("price_max_minor")
  currency            String    @db.Char(3)
  teamNote            String?   @map("team_note") @db.VarChar(1000)
  source              String    @default("hub") @db.VarChar(6)
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz
  cancelledBy         String?   @map("cancelled_by") @db.VarChar(8)
  cancelledByUserId   String?   @map("cancelled_by_user_id") @db.Uuid
  cancelMinutesBefore Int?      @map("cancel_minutes_before")
  cancelLate          Boolean?  @map("cancel_late")
  depositMinor        Int?      @map("deposit_minor")
  depositCurrency     String?   @map("deposit_currency") @db.Char(3)
  paymentDueAt        DateTime? @map("payment_due_at") @db.Timestamptz
  correctedAt         DateTime? @map("corrected_at") @db.Timestamptz
  correctedByUserId   String?   @map("corrected_by_user_id") @db.Uuid
  correctionReason    String?   @map("correction_reason") @db.VarChar(500)
  createdByUserId     String?   @map("created_by_user_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  // Lot B.10: where it takes place (fixed at creation)
  locationId          String?   @map("location_id") @db.Uuid

  staffMember StaffMember          @relation(fields: [staffMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "appointment_staff_member_id_fkey")
  service     Service              @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "appointment_service_id_fkey")
  client      Client               @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "appointment_client_id_fkey")
  history     AppointmentHistory[]
  payments    AppointmentPayment[]
  resources   AppointmentResource[]
  manageTokens ManageToken[]
  moveHolds   PublicHold[]
  answers     AppointmentAnswer[]

  @@unique([organizationId, number], map: "appointment_organization_id_number_key")
  @@unique([organizationId, id], map: "appointment_organization_id_id_key")
  @@index([organizationId, startsAt], map: "appointment_organization_id_starts_idx")
  @@index([staffMemberId, startsAt], map: "appointment_staff_member_id_starts_idx")
  @@index([clientId, startsAt], map: "appointment_client_id_starts_idx")
  @@index([serviceId, startsAt], map: "appointment_service_id_starts_idx")
  @@index([locationId, startsAt], map: "appointment_location_id_starts_idx")
  @@map("appointment")
  @@schema("booking")
}

/// Lot B.4a: what happened to an appointment (D-B4-7), insert only; shown in BookingDetail.
model AppointmentHistory {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  appointmentId  String    @map("appointment_id") @db.Uuid
  kind           String    @db.VarChar(10)
  fromStatus     String?   @map("from_status") @db.VarChar(16)
  toStatus       String?   @map("to_status") @db.VarChar(16)
  startsAt       DateTime? @map("starts_at") @db.Timestamptz
  endsAt         DateTime? @map("ends_at") @db.Timestamptz
  staffMemberId  String?   @map("staff_member_id") @db.Uuid
  actorType      String    @map("actor_type") @db.VarChar(6)
  actorUserId    String?   @map("actor_user_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "appointment_history_appointment_id_fkey")

  @@index([appointmentId, createdAt], map: "appointment_history_appointment_id_idx")
  @@map("appointment_history")
  @@schema("booking")
}

/// Lot B.4a: a blocked time of a member (unavailable); no client, no quota.
model TimeBlock {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  staffMemberId    String    @map("staff_member_id") @db.Uuid
  startsAt         DateTime  @map("starts_at") @db.Timestamptz
  endsAt           DateTime  @map("ends_at") @db.Timestamptz
  reason           String?   @db.VarChar(200)
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz
  archivedByUserId String?   @map("archived_by_user_id") @db.Uuid
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "time_block_staff_member_id_fkey")

  @@index([staffMemberId, startsAt], map: "time_block_staff_member_id_starts_idx")
  @@map("time_block")
  @@schema("booking")
}

/// Lot B.3a: a bookable resource (room, space, equipment); units = how many appointments at once.
model Resource {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  name             String    @db.VarChar(80)
  kind             String    @db.VarChar(9)
  units            Int       @default(1) @db.SmallInt
  sortOrder        Int       @default(0) @map("sort_order")
  // Lot B.10: where it stands; null = every location
  locationId       String?   @map("location_id") @db.Uuid
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz
  archivedByUserId String?   @map("archived_by_user_id") @db.Uuid
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  services     ServiceResource[]
  appointments AppointmentResource[]

  @@index([organizationId, sortOrder], map: "resource_organization_id_sort_idx")
  @@map("resource")
  @@schema("booking")
}

/// Lot B.3a: a service that needs a resource („Servicii care o cer”); removed by archiving.
model ServiceResource {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  serviceId        String    @map("service_id") @db.Uuid
  resourceId       String    @map("resource_id") @db.Uuid
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz
  archivedByUserId String?   @map("archived_by_user_id") @db.Uuid
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "service_resource_service_id_fkey")
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "service_resource_resource_id_fkey")

  @@index([serviceId], map: "service_resource_service_id_idx")
  @@index([resourceId], map: "service_resource_resource_id_idx")
  @@map("service_resource")
  @@schema("booking")
}

/// Lot B.3b: a resource used by an appointment (one unit); insert only.
model AppointmentResource {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  appointmentId  String   @map("appointment_id") @db.Uuid
  resourceId     String   @map("resource_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "appointment_resource_appointment_id_fkey")
  resource    Resource    @relation(fields: [resourceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "appointment_resource_resource_id_fkey")

  @@unique([appointmentId, resourceId], map: "appointment_resource_appointment_id_resource_id_key")
  @@index([resourceId], map: "appointment_resource_resource_id_idx")
  @@map("appointment_resource")
  @@schema("booking")
}

/// Lot B.2b: a member who does a service, ticked one by one (S129); removed by archiving.
model StaffService {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  staffMemberId    String    @map("staff_member_id") @db.Uuid
  serviceId        String    @map("service_id") @db.Uuid
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz
  archivedByUserId String?   @map("archived_by_user_id") @db.Uuid
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "staff_service_staff_member_id_fkey")
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "staff_service_service_id_fkey")

  @@index([staffMemberId], map: "staff_service_staff_member_id_idx")
  @@index([serviceId], map: "staff_service_service_id_idx")
  @@map("staff_service")
  @@schema("booking")
}

/// Lot B.2c: a member's own duration and / or price for a service; NULL = the service's.
model StaffServiceTerms {
  id                 String    @id @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  staffMemberId      String    @map("staff_member_id") @db.Uuid
  serviceId          String    @map("service_id") @db.Uuid
  durationMinutes    Int?      @map("duration_minutes")
  durationMaxMinutes Int?      @map("duration_max_minutes")
  priceKind          String?   @map("price_kind") @db.VarChar(8)
  priceMinor         Int?      @map("price_minor")
  priceMaxMinor      Int?      @map("price_max_minor")
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz
  archivedByUserId   String?   @map("archived_by_user_id") @db.Uuid
  createdByUserId    String    @map("created_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  staffMember StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "staff_service_terms_staff_member_id_fkey")
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "staff_service_terms_service_id_fkey")

  @@index([serviceId], map: "staff_service_terms_service_id_idx")
  @@map("staff_service_terms")
  @@schema("booking")
}

/// Lot B.7a: a block of a client (S125), with its internal reason; unblocking closes it.
model ClientBlock {
  id                String    @id @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  clientId          String    @map("client_id") @db.Uuid
  reason            String    @db.VarChar(500)
  blockedAt         DateTime  @default(now()) @map("blocked_at") @db.Timestamptz
  blockedByUserId   String    @map("blocked_by_user_id") @db.Uuid
  unblockedAt       DateTime? @map("unblocked_at") @db.Timestamptz
  unblockedByUserId String?   @map("unblocked_by_user_id") @db.Uuid
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "client_block_client_id_fkey")

  @@index([clientId], map: "client_block_client_id_idx")
  @@map("client_block")
  @@schema("booking")
}

/// Lot B.7b: a removal of the behaviour note from the card, with its reason (insert only).
model ClientNoteRemoval {
  id              String   @id @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  clientId        String   @map("client_id") @db.Uuid
  reason          String   @db.VarChar(500)
  removedAt       DateTime @default(now()) @map("removed_at") @db.Timestamptz
  removedByUserId String   @map("removed_by_user_id") @db.Uuid

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "client_note_removal_client_id_fkey")

  @@index([clientId, removedAt], map: "client_note_removal_client_id_idx")
  @@map("client_note_removal")
  @@schema("booking")
}

/// Lot B.8: a health field of the business (D-B-14), only on businesses marked medical.
model MedicalField {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  label            String    @db.VarChar(160)
  kind             String    @db.VarChar(8)
  options          Json?
  serviceIds       String[]  @map("service_ids") @db.Uuid
  required         Boolean   @default(false)
  sortOrder        Int       @default(0) @map("sort_order")
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz
  archivedByUserId String?   @map("archived_by_user_id") @db.Uuid
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  answers MedicalAnswer[]

  @@index([organizationId, sortOrder], map: "medical_field_organization_id_sort_idx")
  @@map("medical_field")
  @@schema("booking")
}

/// Lot B.8: the client's consent to the health fields (the version of the text, withdrawable).
model MedicalConsent {
  id                String    @id @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  clientId          String    @map("client_id") @db.Uuid
  textVersion       String    @map("text_version") @db.VarChar(32)
  givenAt           DateTime  @default(now()) @map("given_at") @db.Timestamptz
  source            String    @db.VarChar(6)
  recordedByUserId  String?   @map("recorded_by_user_id") @db.Uuid
  withdrawnAt       DateTime? @map("withdrawn_at") @db.Timestamptz
  withdrawnBy       String?   @map("withdrawn_by") @db.VarChar(8)
  withdrawnByUserId String?   @map("withdrawn_by_user_id") @db.Uuid

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "medical_consent_client_id_fkey")

  @@index([clientId], map: "medical_consent_client_id_idx")
  @@map("medical_consent")
  @@schema("booking")
}

/// Lot B.8: one answer per client and field, encrypted by the application (AES-256-GCM).
model MedicalAnswer {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  clientId        String    @map("client_id") @db.Uuid
  fieldId         String    @map("field_id") @db.Uuid
  valueEncrypted  Bytes?    @map("value_encrypted")
  wipedAt         DateTime? @map("wiped_at") @db.Timestamptz
  updatedByUserId String?   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  client Client       @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "medical_answer_client_id_fkey")
  field  MedicalField @relation(fields: [fieldId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "medical_answer_field_id_fkey")

  @@unique([clientId, fieldId], map: "medical_answer_client_id_field_id_key")
  @@map("medical_answer")
  @@schema("booking")
}

/// Lot B.21: a payment or a refund on an appointment (insert only; a mistake → a refund).
model AppointmentPayment {
  id                String    @id @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  appointmentId     String    @map("appointment_id") @db.Uuid
  clientId          String    @map("client_id") @db.Uuid
  kind              String    @db.VarChar(8)
  amountMinor       Int       @map("amount_minor")
  currency          String    @db.Char(3)
  method            String    @db.VarChar(8)
  note              String?   @db.VarChar(500)
  refundOfPaymentId String?   @map("refund_of_payment_id") @db.Uuid
  recordedAt        DateTime  @default(now()) @map("recorded_at") @db.Timestamptz
  recordedByUserId  String    @map("recorded_by_user_id") @db.Uuid

  appointment Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "appointment_payment_appointment_id_fkey")
  client      Client               @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "appointment_payment_client_id_fkey")
  refundOf    AppointmentPayment?  @relation("PaymentRefund", fields: [refundOfPaymentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "appointment_payment_refund_of_fkey")
  refunds     AppointmentPayment[] @relation("PaymentRefund")

  @@index([appointmentId, recordedAt], map: "appointment_payment_appointment_id_idx")
  @@index([clientId, recordedAt], map: "appointment_payment_client_id_idx")
  @@map("appointment_payment")
  @@schema("booking")
}

/// Lot B.11a: a public booking attempt — the time held 10 minutes until the e-mail code is entered.
/// Migration only: the CHECKs (state, attempts, sends, a settled hold keeps no personal data).
model PublicHold {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  staffMemberId   String    @map("staff_member_id") @db.Uuid
  serviceId       String    @map("service_id") @db.Uuid
  locationId      String?   @map("location_id") @db.Uuid
  startsAt        DateTime  @map("starts_at") @db.Timestamptz
  endsAt          DateTime  @map("ends_at") @db.Timestamptz
  durationMinutes Int       @map("duration_minutes")
  clientName      String?   @map("client_name") @db.VarChar(120)
  clientPhone     String?   @map("client_phone") @db.VarChar(32)
  clientEmail     String?   @map("client_email") @db.VarChar(254)
  clientLocale    String    @default("ro") @map("client_locale") @db.VarChar(5)
  message         String?   @db.VarChar(500)
  /// review #164: set to NULL after 24 hours (booking.public-hold-cleanup)
  emailHash       String?   @map("email_hash") @db.Char(64)
  ipHash          String?   @map("ip_hash") @db.Char(64)
  /// B.11b: null for a move (the token is the proof)
  codeHash        String?   @map("code_hash") @db.Char(64)
  attempts        Int       @default(0) @db.SmallInt
  sends           Int       @default(1) @db.SmallInt
  lastSentAt      DateTime  @default(now()) @map("last_sent_at") @db.Timestamptz
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  state           String    @default("pending") @db.VarChar(9)
  appointmentId   String?   @map("appointment_id") @db.Uuid
  settledAt       DateTime? @map("settled_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// B.11b: the booking being moved by its client (the old time stays theirs until they confirm)
  moveAppointmentId String? @map("move_appointment_id") @db.Uuid
  /// B.12: the answers to the questions, while the hold is pending (wiped when it settles)
  answers           Json?
  /// B.12: a photo was asked for on this hold (the cleanup job deletes those not moved to a booking)
  hasPhotos         Boolean   @default(false) @map("has_photos")

  staffMember     StaffMember  @relation(fields: [staffMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "public_hold_staff_member_id_fkey")
  service         Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "public_hold_service_id_fkey")
  moveAppointment Appointment? @relation(fields: [organizationId, moveAppointmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "public_hold_move_appointment_fkey")

  @@index([staffMemberId, startsAt], map: "public_hold_staff_member_id_starts_idx")
  @@index([moveAppointmentId], map: "public_hold_move_appointment_id_idx")
  @@index([organizationId, createdAt], map: "public_hold_organization_id_created_idx")
  @@map("public_hold")
  @@schema("booking")
}

/// Lot B.11b: the client's link for moving or cancelling a booking (S125); only the SHA-256 of the token.
model ManageToken {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  appointmentId  String    @map("appointment_id") @db.Uuid
  tokenHash      String    @unique(map: "manage_token_token_hash_key") @map("token_hash") @db.Char(64)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz

  appointment Appointment @relation(fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "manage_token_appointment_fkey")

  @@index([appointmentId], map: "manage_token_appointment_id_idx")
  @@map("manage_token")
  @@schema("booking")
}

/// Lot B.12: the questions at booking (BookingCustomForms, S127)
model FormQuestion {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  label            String    @db.VarChar(160)
  kind             String    @db.VarChar(10)
  options          Json?
  helpText         String?   @map("help_text") @db.VarChar(240)
  serviceIds       String[]  @map("service_ids") @db.Uuid
  required         Boolean   @default(false)
  inHub            Boolean   @default(false) @map("in_hub")
  allowsPhoto      Boolean   @default(false) @map("allows_photo")
  sortOrder        Int       @default(0) @map("sort_order")
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz
  archivedByUserId String?   @map("archived_by_user_id") @db.Uuid
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  answers AppointmentAnswer[]

  @@unique([organizationId, id], map: "form_question_organization_id_id_key")
  @@index([organizationId, sortOrder], map: "form_question_organization_id_sort_idx")
  @@map("form_question")
  @@schema("booking")
}

/// Lot B.12: one answer per booking and question (wiped by the GDPR erasure)
model AppointmentAnswer {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  appointmentId   String    @map("appointment_id") @db.Uuid
  questionId      String    @map("question_id") @db.Uuid
  questionLabel   String    @map("question_label") @db.VarChar(160)
  value           Json?
  /// the optional photo: files.file.id (core/files; another schema, no FK)
  photoFileId     String?   @map("photo_file_id") @db.Uuid
  photoDeletedAt  DateTime? @map("photo_deleted_at") @db.Timestamptz
  source          String    @db.VarChar(6)
  updatedByUserId String?   @map("updated_by_user_id") @db.Uuid
  wipedAt         DateTime? @map("wiped_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  appointment Appointment  @relation(fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "appointment_answer_appointment_fkey")
  question    FormQuestion @relation(fields: [organizationId, questionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "appointment_answer_question_fkey")

  @@unique([appointmentId, questionId], map: "appointment_answer_appointment_id_question_id_key")
  @@index([questionId], map: "appointment_answer_question_id_idx")
  @@map("appointment_answer")
  @@schema("booking")
}
