  dateFrom              DateTime  @map("date_from") @db.Date
  dateTo                DateTime  @map("date_to") @db.Date
  timeKind              String    @map("time_kind") @db.VarChar(10)
  fromMinute            Int?      @map("from_minute") @db.SmallInt
  toMinute              Int?      @map("to_minute") @db.SmallInt
  note                  String?   @db.VarChar(500)
  status                String    @default("waiting") @db.VarChar(10)
  acceptedAppointmentId String?   @map("accepted_appointment_id") @db.Uuid
  removedAt             DateTime? @map("removed_at") @db.Timestamptz
  removedByUserId       String?   @map("removed_by_user_id") @db.Uuid
  /// B.9d2: the entry waits for this class session (automatic offers, D-9d-2)
  classSessionId        String?   @map("class_session_id") @db.Uuid
  createdByUserId       String    @map("created_by_user_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  client      Client          @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "waitlist_entry_client_org_fkey")
  service     Service         @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "waitlist_entry_service_org_fkey")
  staffMember StaffMember?    @relation(fields: [organizationId, staffMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "waitlist_entry_staff_member_org_fkey")
  appointment Appointment?    @relation(fields: [organizationId, acceptedAppointmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "waitlist_entry_appointment_fkey")
  classSession ClassSession?   @relation(fields: [organizationId, classSessionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "waitlist_entry_class_session_fkey")
  offers      WaitlistOffer[]

  @@unique([organizationId, id], map: "waitlist_entry_organization_id_id_key")
  @@index([organizationId, status, createdAt], map: "waitlist_entry_organization_id_status_created_idx")
  @@index([clientId], map: "waitlist_entry_client_id_idx")
  @@map("waitlist_entry")
  @@schema("booking")
}

model WaitlistOffer {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  entryId         String    @map("entry_id") @db.Uuid
  staffMemberId   String    @map("staff_member_id") @db.Uuid
  startsAt        DateTime  @map("starts_at") @db.Timestamptz
  endsAt          DateTime  @map("ends_at") @db.Timestamptz
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz
  channel         String    @db.VarChar(5)
  tokenHash       String    @unique(map: "waitlist_offer_token_hash_key") @map("token_hash") @db.Char(64)
  state           String    @default("pending") @db.VarChar(10)
  appointmentId   String?   @map("appointment_id") @db.Uuid
  closedAt        DateTime? @map("closed_at") @db.Timestamptz
  /// B.9d2: a seat of this class session; the automatic offer has no user
  classSessionId  String?   @map("class_session_id") @db.Uuid
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  entry       WaitlistEntry @relation(fields: [organizationId, entryId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "waitlist_offer_entry_fkey")
  staffMember StaffMember   @relation(fields: [organizationId, staffMemberId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "waitlist_offer_staff_member_org_fkey")
  appointment Appointment?  @relation(fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "waitlist_offer_appointment_fkey")
  classSession ClassSession? @relation(fields: [organizationId, classSessionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "waitlist_offer_class_session_fkey")

  @@index([entryId], map: "waitlist_offer_entry_id_idx")
  @@index([staffMemberId, startsAt], map: "waitlist_offer_staff_member_id_starts_idx")
  @@map("waitlist_offer")
  @@schema("booking")
}

// Lot B.9e: the packages of sessions (BookingPackages, S126); the open use per appointment is a
// partial index left to the migration (package_use_open_appointment_key)
model Package {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  serviceId        String    @map("service_id") @db.Uuid
  name             String    @db.VarChar(80)
  sessions         Int       @db.SmallInt
  validityMonths   Int?      @map("validity_months") @db.SmallInt
  priceMinor       Int       @map("price_minor")
  currency         String    @db.Char(3)
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz
  archivedByUserId String?   @map("archived_by_user_id") @db.Uuid
  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  service Service       @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "package_service_org_fkey")
  sales   PackageSale[]

  @@unique([organizationId, id], map: "package_organization_id_id_key")
  @@index([serviceId], map: "package_service_id_idx")
  @@map("package")
  @@schema("booking")
}

model PackageSale {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  packageId        String    @map("package_id") @db.Uuid
  clientId         String    @map("client_id") @db.Uuid
  serviceId        String    @map("service_id") @db.Uuid
  packageName      String    @map("package_name") @db.VarChar(80)
  sessions         Int       @db.SmallInt
  priceMinor       Int       @map("price_minor")
  currency         String    @db.Char(3)
  method           String    @db.VarChar(8)
  validFrom        DateTime  @map("valid_from") @db.Date
  validUntil       DateTime? @map("valid_until") @db.Date
  note             String?   @db.VarChar(500)
  extendedAt       DateTime? @map("extended_at") @db.Timestamptz
  extendedByUserId String?   @map("extended_by_user_id") @db.Uuid
  extensionReason  String?   @map("extension_reason") @db.VarChar(300)
  soldByUserId     String    @map("sold_by_user_id") @db.Uuid
  soldAt           DateTime  @default(now()) @map("sold_at") @db.Timestamptz

  package Package      @relation(fields: [organizationId, packageId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "package_sale_package_fkey")
  client  Client       @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "package_sale_client_org_fkey")
  service Service      @relation(fields: [organizationId, serviceId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "package_sale_service_org_fkey")
  uses    PackageUse[]

  @@unique([organizationId, id], map: "package_sale_organization_id_id_key")
  @@index([clientId, soldAt], map: "package_sale_client_id_idx")
  @@index([packageId], map: "package_sale_package_id_idx")
  @@map("package_sale")
  @@schema("booking")
}

model PackageUse {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  saleId          String    @map("sale_id") @db.Uuid
  appointmentId   String    @map("appointment_id") @db.Uuid
  state           String    @default("reserved") @db.VarChar(8)
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  settledAt       DateTime? @map("settled_at") @db.Timestamptz

  sale        PackageSale @relation(fields: [organizationId, saleId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "package_use_sale_fkey")
  appointment Appointment @relation(fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "package_use_appointment_fkey")

  @@index([saleId], map: "package_use_sale_id_idx")
  @@map("package_use")
  @@schema("booking")
}

// Lot B.13: the queue of the e-mails to the clients (BookingClientEmails, S116); no personal data
model ClientMessage {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  appointmentId  String    @map("appointment_id") @db.Uuid
  kind           String    @db.VarChar(20)
  dedupeKey      String    @map("dedupe_key") @db.VarChar(120)
  sendAfter      DateTime  @map("send_after") @db.Timestamptz
  validUntil     DateTime  @map("valid_until") @db.Timestamptz
  state          String    @default("pending") @db.VarChar(10)
  attempts       Int       @default(0) @db.SmallInt
  reason         String?   @db.VarChar(40)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  appointment Appointment @relation(fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "client_message_appointment_fkey")

  @@unique([organizationId, dedupeKey], map: "client_message_organization_id_dedupe_key_key")
  @@index([organizationId, state, sendAfter], map: "client_message_organization_id_state_send_idx")
  @@index([appointmentId], map: "client_message_appointment_id_idx")
  @@map("client_message")
  @@schema("booking")
}

/// Lot B.14b (S127): the business's text of a client e-mail, per language; subject / body NULL = the Ventora text.
model MessageTemplate {
  organizationId  String   @map("organization_id") @db.Uuid
  kind            String   @db.VarChar(20)
  locale          String   @db.VarChar(5)
  subject         String?  @db.VarChar(150)
  body            String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid

  @@id([organizationId, kind, locale], map: "message_template_pkey")
  @@map("message_template")
  @@schema("booking")
}

/// Lot B.22a: the salon's Stripe account (direct charges, Accounts v2); one per business.
model StripeAccount {
  organizationId    String    @id @map("organization_id") @db.Uuid
  stripeAccountId   String    @unique(map: "stripe_account_stripe_account_id_key") @map("stripe_account_id") @db.VarChar(64)
  status            String    @default("onboarding") @db.VarChar(12)
  displayName       String?   @map("display_name") @db.VarChar(255)
  everActive        Boolean   @default(false) @map("ever_active")
  statusCheckedAt   DateTime  @default(now()) @map("status_checked_at") @db.Timestamptz
  connectedByUserId String    @map("connected_by_user_id") @db.Uuid
  disconnectedAt    DateTime? @map("disconnected_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@map("stripe_account")
  @@schema("booking")
}
