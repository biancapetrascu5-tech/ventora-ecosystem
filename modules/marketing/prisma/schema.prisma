// Schema "marketing" (Lot MK.1; modules/marketing/prisma/, ca la crm) — folosită pentru garda de
// drift (prisma migrate diff) și prisma migrate deploy. Codul nu folosește un client Prisma generat:
// rulează pe pg, cu SET LOCAL ROLE marketing_rw și app.organization_id.
// CHECK-urile, triggerele, rolul, grant-urile și RLS sunt doar în migrare.

datasource db {
  provider = "postgresql"
  schemas  = ["marketing"]
}

/// Lot MK.1: the CampaignKit settings of a business (CampaignKitSettings, S139); one row.
model Settings {
  organizationId  String   @id @map("organization_id") @db.Uuid
  senderName      String?  @map("sender_name") @db.VarChar(80)
  replyTo         String?  @map("reply_to") @db.VarChar(254)
  /// D-CK-15 = a: at most 2 marketing messages in 7 days per person (1–4 in 7–30).
  capMessages     Int      @default(2) @map("cap_messages") @db.SmallInt
  capDays         Int      @default(7) @map("cap_days") @db.SmallInt
  /// D-CK-15: SMS only between 9:00 and 20:00 (minutes from midnight, Romania's time).
  smsFromMinute   Int      @default(540) @map("sms_from_minute") @db.SmallInt
  smsToMinute     Int      @default(1200) @map("sms_to_minute") @db.SmallInt
  skipSunday      Boolean  @default(true) @map("skip_sunday")
  skipSaturday    Boolean  @default(false) @map("skip_saturday")
  skipHolidays    Boolean  @default(true) @map("skip_holidays")
  /// D-CK-14 = a: members' campaigns go through approval.
  memberApproval  Boolean  @default(true) @map("member_approval")
  updatedByUserId String   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("settings")
  @@schema("marketing")
}

/// Lot MK.2: a marketing contact of the business (D-CK-2 = a); the links are ids only (D-CRM-1).
model Contact {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String?   @db.VarChar(160)
  email           String?   @db.VarChar(254)
  phone           String?   @db.VarChar(16)
  locale          String?   @db.VarChar(2)
  tags            String[]  @default([])
  customFields    Json      @default("{}") @map("custom_fields")
  source          String    @db.VarChar(16)
  crmContactId    String?   @map("crm_contact_id") @db.Uuid
  bookingClientId String?   @map("booking_client_id") @db.Uuid
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz
  mergedIntoId    String?   @map("merged_into_id") @db.Uuid
  /// Review #192: the GDPR erasure (marketing.erase_contact); the personal data emptied
  erasedAt        DateTime? @map("erased_at") @db.Timestamptz
  erasedByUserId  String?   @map("erased_by_user_id") @db.Uuid
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  mergedInto  Contact?             @relation("ContactMerge", fields: [organizationId, mergedIntoId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "contact_merged_into_id_fkey")
  mergedFrom  Contact[]            @relation("ContactMerge")
  events      ContactEvent[]
  dismissedA  DuplicateDismissal[] @relation("DismissalA")
  dismissedB  DuplicateDismissal[] @relation("DismissalB")

  @@unique([organizationId, id], map: "contact_organization_id_id_key")
  @@index([organizationId, email], map: "contact_email_idx")
  @@index([organizationId, phone], map: "contact_phone_idx")
  @@index([organizationId, createdAt(sort: Desc)], map: "contact_list_idx")
  @@map("contact")
  @@schema("marketing")
}

/// Lot MK.2: the history of a contact; append-only.
model ContactEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  contactId      String   @map("contact_id") @db.Uuid
  kind           String   @db.VarChar(16)
  channel        String?  @db.VarChar(8)
  campaignId     String?  @map("campaign_id") @db.Uuid
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  contact Contact @relation(fields: [organizationId, contactId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "contact_event_contact_id_fkey")

  @@index([organizationId, contactId, occurredAt(sort: Desc)], map: "contact_event_contact_idx")
  @@map("contact_event")
  @@schema("marketing")
}

/// Lot MK.2: „Nu sunt duplicate” for a pair (stored once, a < b).
model DuplicateDismissal {
  organizationId    String   @map("organization_id") @db.Uuid
  contactAId        String   @map("contact_a_id") @db.Uuid
  contactBId        String   @map("contact_b_id") @db.Uuid
  dismissedByUserId String   @map("dismissed_by_user_id") @db.Uuid
  dismissedAt       DateTime @default(now()) @map("dismissed_at") @db.Timestamptz

  contactA Contact @relation("DismissalA", fields: [organizationId, contactAId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "duplicate_dismissal_a_fkey")
  contactB Contact @relation("DismissalB", fields: [organizationId, contactBId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "duplicate_dismissal_b_fkey")

  @@id([organizationId, contactAId, contactBId])
  @@map("duplicate_dismissal")
  @@schema("marketing")
}
