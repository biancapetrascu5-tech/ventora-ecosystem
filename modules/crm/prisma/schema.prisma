// Schema "crm" (Lot CR.1; modules/crm/prisma/, ca la booking) — folosită pentru garda de drift
// (prisma migrate diff) și prisma migrate deploy. Codul nu folosește un client Prisma generat:
// rulează pe pg, cu SET LOCAL ROLE crm_rw și app.organization_id.
// CHECK-urile, triggerele, rolul, grant-urile, RLS și funcțiile outbox sunt doar în migrare.

datasource db {
  provider = "postgresql"
  schemas  = ["crm"]
}

/// Lot CR.1: the ClientDesk preferences of a business; one row, written on the first save.
model Settings {
  organizationId      String   @id @map("organization_id") @db.Uuid
  /// D-CRM-2 = c: the automatic EasyBook link, on by default.
  bookingLinkEnabled  Boolean  @default(true) @map("booking_link_enabled")
  /// CR.4: the days of the predefined segment „N-au mai venit” (S130: 60, 7–365).
  lapsedSegmentDays   Int      @default(60) @map("lapsed_segment_days") @db.SmallInt
  updatedByUserId     String   @map("updated_by_user_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("settings")
  @@schema("crm")
}

/// Lot CR.2: a company (S130: one company per contact).
model Company {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String    @db.VarChar(160)
  taxId           String?   @map("tax_id") @db.VarChar(12)
  industry        String?   @db.VarChar(80)
  address         String?   @db.VarChar(300)
  website         String?   @db.VarChar(200)
  phone           String?   @db.VarChar(16)
  email           String?   @db.VarChar(254)
  ownerUserId     String?   @map("owner_user_id") @db.Uuid
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  /// CR.3: the business's own fields, { "<field id>": value }
  customValues    Json      @default("{}") @map("custom_values")

  contacts Contact[]

  @@index([customValues(ops: JsonbPathOps)], type: Gin, map: "company_custom_values_idx")

  @@map("company")
  @@schema("crm")
}

/// Lot CR.2: a contact; in the 30-day bin when deleted_at is set (S130).
model Contact {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  name             String    @db.VarChar(160)
  phone            String?   @db.VarChar(16)
  phoneAlt         String?   @map("phone_alt") @db.VarChar(16)
  email            String?   @db.VarChar(254)
  emailAlt         String?   @map("email_alt") @db.VarChar(254)
  locale           String    @default("ro") @db.VarChar(2)
  birthday         DateTime? @db.Date
  address          String?   @db.VarChar(300)
  source           String    @default("manual") @db.VarChar(12)
  companyId        String?   @map("company_id") @db.Uuid
  companyRole      String?   @map("company_role") @db.VarChar(80)
  isCompanyPrimary Boolean   @default(false) @map("is_company_primary")
  ownerUserId      String?   @map("owner_user_id") @db.Uuid
  note             String?   @db.VarChar(1000)
  quotaOperationId String?   @map("quota_operation_id") @db.VarChar(128)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  deletedByUserId  String?   @map("deleted_by_user_id") @db.Uuid
  createdByUserId  String?   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  /// CR.3: the business's own fields, { "<field id>": value }
  customValues     Json      @default("{}") @map("custom_values")
  /// CR.4: the tags of the contact
  tagIds           String[]  @default([]) @map("tag_ids") @db.Uuid
  /// CR.5: the normalised name (crm.name_key, kept by a trigger)
  nameKey          String    @default("") @map("name_key")
  /// CR.5: merged into this contact (in the bin)
  mergedIntoId     String?   @map("merged_into_id") @db.Uuid

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "contact_company_id_fkey")
  mergedInto      Contact?  @relation("ContactMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "contact_merged_into_id_fkey")
  mergedFrom      Contact[] @relation("ContactMerge")
  dismissalsA     DuplicateDismissal[] @relation("DismissalA")
  dismissalsB     DuplicateDismissal[] @relation("DismissalB")
  mergesKept      ContactMerge[]       @relation("MergeKept")
  mergesMerged    ContactMerge[]       @relation("MergeMerged")

  @@index([organizationId, phone], map: "contact_organization_id_phone_idx")
  @@index([organizationId, email], map: "contact_organization_id_email_idx")
  @@index([organizationId, ownerUserId], map: "contact_organization_id_owner_idx")
  @@index([companyId], map: "contact_company_id_idx")
  @@index([customValues(ops: JsonbPathOps)], type: Gin, map: "contact_custom_values_idx")
  @@index([tagIds], type: Gin, map: "contact_tag_ids_idx")
  @@index([organizationId, nameKey], map: "contact_organization_id_name_key_idx")
  @@index([organizationId, phoneAlt], map: "contact_organization_id_phone_alt_idx")
  @@index([organizationId, emailAlt], map: "contact_organization_id_email_alt_idx")
  @@index([mergedIntoId], map: "contact_merged_into_id_idx")
  @@map("contact")
  @@schema("crm")
}

/// Lot CR.3: a field of the business (S132: at most 30; the type locked once there are values).
model CustomField {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String    @db.VarChar(60)
  fieldType       String    @map("field_type") @db.VarChar(8)
  options         Json?
  appliesTo       String[]  @map("applies_to")
  isRequired      Boolean   @default(false) @map("is_required")
  showInList      Boolean   @default(false) @map("show_in_list")
  inImport        Boolean   @default(true) @map("in_import")
  sortOrder       Int       @default(0) @map("sort_order")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@index([organizationId, sortOrder], map: "custom_field_organization_id_sort_idx")
  @@map("custom_field")
  @@schema("crm")
}

/// Lot CR.4: a tag of the business (S132).
model Tag {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String    @db.VarChar(40)
  color           String    @default("neutral") @db.VarChar(16)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@map("tag")
  @@schema("crm")
}

/// Lot CR.4: a saved segment (S130); the rules are evaluated on every read.
model Segment {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String    @db.VarChar(80)
  rules           Json      @default("[]")
  match           String    @default("all") @db.VarChar(3)
  visibility      String    @default("team") @db.VarChar(4)
  kind            String    @default("custom") @db.VarChar(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@index([organizationId], map: "segment_organization_id_idx")
  @@map("segment")
  @@schema("crm")
}

/// Lot CR.5: „Nu sunt duplicate” (S132); undone_at instead of a delete.
model DuplicateDismissal {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  contactAId      String    @map("contact_a_id") @db.Uuid
  contactBId      String    @map("contact_b_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  undoneAt        DateTime? @map("undone_at") @db.Timestamptz
  undoneByUserId  String?   @map("undone_by_user_id") @db.Uuid

  contactA Contact @relation("DismissalA", fields: [contactAId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "duplicate_dismissal_contact_a_fkey")
  contactB Contact @relation("DismissalB", fields: [contactBId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "duplicate_dismissal_contact_b_fkey")

  @@map("duplicate_dismissal")
  @@schema("crm")
}

/// Lot CR.5: the log of the merges (INSERT + SELECT only).
model ContactMerge {
  id               String   @id @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  keptContactId    String   @map("kept_contact_id") @db.Uuid
  mergedContactId  String   @map("merged_contact_id") @db.Uuid
  fieldsFromMerged String[] @default([]) @map("fields_from_merged")
  createdByUserId  String   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  kept   Contact @relation("MergeKept", fields: [keptContactId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "contact_merge_kept_fkey")
  merged Contact @relation("MergeMerged", fields: [mergedContactId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "contact_merge_merged_fkey")

  @@index([keptContactId], map: "contact_merge_kept_idx")
  @@map("contact_merge")
  @@schema("crm")
}

model OutboxEvent {
  eventId        String    @id @map("event_id") @db.Uuid
  type           String    @db.VarChar(128)
  version        Int
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz
  organizationId String    @map("organization_id") @db.Uuid
  sourceApp      String    @map("source_app") @db.VarChar(64)
  resourceId     String    @map("resource_id") @db.VarChar(255)
  correlationId  String?   @map("correlation_id") @db.VarChar(255)
  payload        Json
  status         String    @default("pending") @db.VarChar(16)
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz
  lastError      String?   @map("last_error")
  failedAt       DateTime? @map("failed_at") @db.Timestamptz
  dispatchedAt   DateTime? @map("dispatched_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("outbox_events")
  @@schema("crm")
}

model ProcessedEvent {
  consumer       String   @db.VarChar(128)
  eventId        String   @map("event_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  processedAt    DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@id([consumer, eventId])
  @@map("processed_events")
  @@schema("crm")
}
