// Schema "crm" (Lot CR.1; modules/crm/prisma/, ca la booking) — folosită pentru garda de drift
// (prisma migrate diff) și prisma migrate deploy. Codul nu folosește un client Prisma generat:
// rulează pe pg, cu SET LOCAL ROLE crm_rw și app.organization_id.
// CHECK-urile, triggerele, rolul, grant-urile, RLS și funcțiile outbox sunt doar în migrare.

datasource db {
  provider = "postgresql"
  schemas  = ["crm"]
}

/// Lot CR.1: the ClientDesk preferences of a business; one row, written on the first save.
model Settings {
  organizationId      String   @id @map("organization_id") @db.Uuid
  /// D-CRM-2 = c: the automatic EasyBook link, on by default.
  bookingLinkEnabled  Boolean  @default(true) @map("booking_link_enabled")
  /// CR.4: the days of the predefined segment „N-au mai venit” (S130: 60, 7–365).
  lapsedSegmentDays   Int      @default(60) @map("lapsed_segment_days") @db.SmallInt
  /// CR.10: the lead score switch and the minimum budget
  leadScoringEnabled  Boolean  @default(true) @map("lead_scoring_enabled")
  leadMinBudgetMinor  BigInt?  @map("lead_min_budget_minor")
  updatedByUserId     String   @map("updated_by_user_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("settings")
  @@schema("crm")
}

/// Lot CR.2: a company (S130: one company per contact).
model Company {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String    @db.VarChar(160)
  taxId           String?   @map("tax_id") @db.VarChar(12)
  industry        String?   @db.VarChar(80)
  address         String?   @db.VarChar(300)
  website         String?   @db.VarChar(200)
  phone           String?   @db.VarChar(16)
  email           String?   @db.VarChar(254)
  ownerUserId     String?   @map("owner_user_id") @db.Uuid
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  /// CR.3: the business's own fields, { "<field id>": value }
  customValues    Json      @default("{}") @map("custom_values")

  contacts Contact[]
  deals    Deal[]

  @@index([customValues(ops: JsonbPathOps)], type: Gin, map: "company_custom_values_idx")

  @@map("company")
  @@schema("crm")
}

/// Lot CR.2: a contact; in the 30-day bin when deleted_at is set (S130).
model Contact {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  name             String    @db.VarChar(160)
  phone            String?   @db.VarChar(16)
  phoneAlt         String?   @map("phone_alt") @db.VarChar(16)
  email            String?   @db.VarChar(254)
  emailAlt         String?   @map("email_alt") @db.VarChar(254)
  locale           String    @default("ro") @db.VarChar(2)
  birthday         DateTime? @db.Date
  address          String?   @db.VarChar(300)
  source           String    @default("manual") @db.VarChar(12)
  companyId        String?   @map("company_id") @db.Uuid
  companyRole      String?   @map("company_role") @db.VarChar(80)
  isCompanyPrimary Boolean   @default(false) @map("is_company_primary")
  ownerUserId      String?   @map("owner_user_id") @db.Uuid
  note             String?   @db.VarChar(1000)
  quotaOperationId String?   @map("quota_operation_id") @db.VarChar(128)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  deletedByUserId  String?   @map("deleted_by_user_id") @db.Uuid
  createdByUserId  String?   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  /// CR.3: the business's own fields, { "<field id>": value }
  customValues     Json      @default("{}") @map("custom_values")
  /// CR.4: the tags of the contact
  tagIds           String[]  @default([]) @map("tag_ids") @db.Uuid
  /// CR.5: the normalised name (crm.name_key, kept by a trigger)
  nameKey          String    @default("") @map("name_key")
  /// CR.5: merged into this contact (in the bin)
  mergedIntoId     String?   @map("merged_into_id") @db.Uuid

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "contact_company_id_fkey")
  mergedInto      Contact?  @relation("ContactMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "contact_merged_into_id_fkey")
  mergedFrom      Contact[] @relation("ContactMerge")
  dismissalsA     DuplicateDismissal[] @relation("DismissalA")
  dismissalsB     DuplicateDismissal[] @relation("DismissalB")
  mergesKept      ContactMerge[]       @relation("MergeKept")
  mergesMerged    ContactMerge[]       @relation("MergeMerged")
  leads           Lead[]
  deals           Deal[]

  @@index([organizationId, phone], map: "contact_organization_id_phone_idx")
  @@index([organizationId, email], map: "contact_organization_id_email_idx")
  @@index([organizationId, ownerUserId], map: "contact_organization_id_owner_idx")
  @@index([companyId], map: "contact_company_id_idx")
  @@index([customValues(ops: JsonbPathOps)], type: Gin, map: "contact_custom_values_idx")
  @@index([tagIds], type: Gin, map: "contact_tag_ids_idx")
  @@index([organizationId, nameKey], map: "contact_organization_id_name_key_idx")
  @@index([organizationId, phoneAlt], map: "contact_organization_id_phone_alt_idx")
  @@index([organizationId, emailAlt], map: "contact_organization_id_email_alt_idx")
  @@index([mergedIntoId], map: "contact_merged_into_id_idx")
  @@map("contact")
  @@schema("crm")
}

/// Lot CR.3: a field of the business (S132: at most 30; the type locked once there are values).
model CustomField {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String    @db.VarChar(60)
  fieldType       String    @map("field_type") @db.VarChar(8)
  options         Json?
  appliesTo       String[]  @map("applies_to")
  isRequired      Boolean   @default(false) @map("is_required")
  showInList      Boolean   @default(false) @map("show_in_list")
  inImport        Boolean   @default(true) @map("in_import")
  sortOrder       Int       @default(0) @map("sort_order")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@index([organizationId, sortOrder], map: "custom_field_organization_id_sort_idx")
  @@map("custom_field")
  @@schema("crm")
}

/// Lot CR.4: a tag of the business (S132).
model Tag {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String    @db.VarChar(40)
  color           String    @default("neutral") @db.VarChar(16)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@map("tag")
  @@schema("crm")
}

/// Lot CR.4: a saved segment (S130); the rules are evaluated on every read.
model Segment {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  name            String    @db.VarChar(80)
  rules           Json      @default("[]")
  match           String    @default("all") @db.VarChar(3)
  visibility      String    @default("team") @db.VarChar(4)
  kind            String    @default("custom") @db.VarChar(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@index([organizationId], map: "segment_organization_id_idx")
  @@map("segment")
  @@schema("crm")
}

/// Lot CR.6: the notes and the internal comments (S130 „Un singur istoric”); bin, no delete.
model Note {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  kind            String    @db.VarChar(7)
  subjectType     String    @map("subject_type") @db.VarChar(7)
  subjectId       String    @map("subject_id") @db.Uuid
  body            String
  mentions        String[]  @default([]) @db.Uuid
  editedAt        DateTime? @map("edited_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@index([organizationId, subjectType, subjectId, createdAt(sort: Desc)], map: "note_subject_idx")
  @@index([mentions], type: Gin, map: "note_mentions_idx")
  @@map("note")
  @@schema("crm")
}

/// Lot CR.9: the pipelines (stock quota crm.pipelines; S131: 2), one is the default.
model Pipeline {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  key              String?   @db.VarChar(12)
  name             String?   @db.VarChar(60)
  isDefault        Boolean   @default(false) @map("is_default")
  sortOrder        Int       @default(0) @map("sort_order")
  quotaOperationId String?   @map("quota_operation_id") @db.VarChar(80)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  deletedByUserId  String?   @map("deleted_by_user_id") @db.Uuid
  createdByUserId  String?   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  stages Stage[]
  deals  Deal[]

  @@index([organizationId], map: "pipeline_organization_id_idx")
  @@map("pipeline")
  @@schema("crm")
}

/// Lot CR.9: the open stages of a pipeline, with their default probability.
model Stage {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  pipelineId      String    @map("pipeline_id") @db.Uuid
  key             String?   @db.VarChar(16)
  name            String?   @db.VarChar(40)
  sortOrder       Int       @default(0) @map("sort_order")
  probability     Int       @default(0)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "stage_pipeline_id_fkey")
  deals    Deal[]

  @@index([pipelineId, sortOrder], map: "stage_pipeline_id_idx")
  @@map("stage")
  @@schema("crm")
}

/// Lot CR.9: the loss reasons of the business (S131 defaults by key).
model LossReason {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  key             String?   @db.VarChar(12)
  label           String?   @db.VarChar(80)
  sortOrder       Int       @default(0) @map("sort_order")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  deals Deal[]

  @@index([organizationId], map: "loss_reason_organization_id_idx")
  @@map("loss_reason")
  @@schema("crm")
}

/// Lot CR.9: the deals (S131); items in jsonb (free items now, EasyBook services with CR.12).
model Deal {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  pipelineId      String    @map("pipeline_id") @db.Uuid
  stageId         String    @map("stage_id") @db.Uuid
  title           String    @db.VarChar(160)
  contactId       String?   @map("contact_id") @db.Uuid
  companyId       String?   @map("company_id") @db.Uuid
  leadId          String?   @map("lead_id") @db.Uuid
  currency        String    @default("RON") @db.VarChar(3)
  items           Json      @default("[]")
  valueMinor      BigInt    @default(0) @map("value_minor")
  probability     Int       @default(0)
  expectedCloseOn DateTime? @map("expected_close_on") @db.Date
  ownerUserId     String?   @map("owner_user_id") @db.Uuid
  status          String    @default("open") @db.VarChar(4)
  stageChangedAt  DateTime  @default(now()) @map("stage_changed_at") @db.Timestamptz
  wonValueMinor   BigInt?   @map("won_value_minor")
  closedOn        DateTime? @map("closed_on") @db.Date
  closeNote       String?   @map("close_note") @db.VarChar(500)
  lossReasonId    String?   @map("loss_reason_id") @db.Uuid
  closedAt        DateTime? @map("closed_at") @db.Timestamptz
  closedByUserId  String?   @map("closed_by_user_id") @db.Uuid
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  pipeline     Pipeline          @relation(fields: [pipelineId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "deal_pipeline_id_fkey")
  stage        Stage             @relation(fields: [stageId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "deal_stage_id_fkey")
  contact      Contact?          @relation(fields: [contactId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "deal_contact_id_fkey")
  company      Company?          @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "deal_company_id_fkey")
  lead         Lead?             @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "deal_lead_id_fkey")
  lossReason   LossReason?       @relation(fields: [lossReasonId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "deal_loss_reason_id_fkey")
  stageChanges DealStageChange[]

  @@index([organizationId, pipelineId, status, stageId], map: "deal_pipeline_idx")
  @@index([contactId], map: "deal_contact_id_idx")
  @@index([companyId], map: "deal_company_id_idx")
  @@index([organizationId, ownerUserId], map: "deal_owner_idx")
  @@map("deal")
  @@schema("crm")
}

/// Lot CR.9: the history of a deal's moves (INSERT + SELECT only).
model DealStageChange {
  id              String   @id @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  dealId          String   @map("deal_id") @db.Uuid
  fromStageId     String?  @map("from_stage_id") @db.Uuid
  toStageId       String   @map("to_stage_id") @db.Uuid
  changedByUserId String   @map("changed_by_user_id") @db.Uuid
  changedAt       DateTime @default(now()) @map("changed_at") @db.Timestamptz

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "deal_stage_change_deal_id_fkey")

  @@index([dealId, changedAt], map: "deal_stage_change_deal_id_idx")
  @@map("deal_stage_change")
  @@schema("crm")
}

/// Lot CR.8b: the lead sources (S132): built-in ones renamed / hidden, the business's own deleted.
model LeadSource {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  key             String?   @db.VarChar(8)
  label           String?   @db.VarChar(60)
  hidden          Boolean   @default(false)
  sortOrder       Int       @default(0) @map("sort_order")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  leads Lead[]

  @@index([organizationId], map: "lead_source_organization_id_idx")
  @@map("lead_source")
  @@schema("crm")
}

/// Lot CR.8: the leads (D-CRM-3, S131), apart from the contacts; bin, no delete.
model Lead {
  id                 String    @id @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  name               String    @db.VarChar(160)
  phone              String?   @db.VarChar(16)
  email              String?   @db.VarChar(254)
  request            String?   @db.VarChar(5000)
  source             String    @default("manual") @db.VarChar(8)
  /// CR.8b: the business's own source (source = 'custom')
  sourceId           String?   @map("source_id") @db.Uuid
  referredBy         String?   @map("referred_by") @db.VarChar(160)
  budgetMinor        BigInt?   @map("budget_minor")
  currency           String    @default("RON") @db.VarChar(3)
  eventDate          DateTime? @map("event_date") @db.Date
  ownerUserId        String?   @map("owner_user_id") @db.Uuid
  state              String    @default("new") @db.VarChar(12)
  disqualifyReason   String?   @map("disqualify_reason") @db.VarChar(11)
  disqualifyNote     String?   @map("disqualify_note") @db.VarChar(500)
  closedAt           DateTime? @map("closed_at") @db.Timestamptz
  closedByUserId     String?   @map("closed_by_user_id") @db.Uuid
  convertedContactId String?   @map("converted_contact_id") @db.Uuid
  /// CR.10: the score signals
  askedPrice         Boolean   @default(false) @map("asked_price")
  offerOpenedAt      DateTime? @map("offer_opened_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz
  deletedByUserId    String?   @map("deleted_by_user_id") @db.Uuid
  createdByUserId    String?   @map("created_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  convertedContact Contact? @relation(fields: [convertedContactId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "lead_converted_contact_id_fkey")
  deals            Deal[]
  ownSource        LeadSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "lead_source_id_fkey")

  @@index([sourceId], map: "lead_source_id_idx")
  @@index([organizationId, state, createdAt(sort: Desc)], map: "lead_organization_id_state_idx")
  @@index([organizationId, ownerUserId], map: "lead_organization_id_owner_idx")
  @@index([organizationId, phone], map: "lead_organization_id_phone_idx")
  @@index([organizationId, email], map: "lead_organization_id_email_idx")
  @@index([convertedContactId], map: "lead_converted_contact_id_idx")
  @@map("lead")
  @@schema("crm")
}

/// Lot CR.7: tasks, logged calls / meetings / e-mails, reminders (S131); bin, no delete.
model Activity {
  id                  String    @id @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  kind                String    @db.VarChar(8)
  title               String    @db.VarChar(200)
  note                String?   @db.VarChar(2000)
  priority            String    @default("normal") @db.VarChar(6)
  subjectType         String?   @map("subject_type") @db.VarChar(7)
  subjectId           String?   @map("subject_id") @db.Uuid
  ownerUserId         String    @map("owner_user_id") @db.Uuid
  dueOn               DateTime? @map("due_on") @db.Date
  dueAt               DateTime? @map("due_at") @db.Timestamptz
  durationMinutes     Int?      @map("duration_minutes")
  remindBeforeMinutes Int?      @map("remind_before_minutes")
  remindAt            DateTime? @map("remind_at") @db.Timestamptz
  remindedAt          DateTime? @map("reminded_at") @db.Timestamptz
  callResult          String?   @map("call_result") @db.VarChar(12)
  meetingPlace        String?   @map("meeting_place") @db.VarChar(6)
  participantUserIds  String[]  @default([]) @map("participant_user_ids") @db.Uuid
  outcome             String?   @db.VarChar(500)
  status              String    @default("open") @db.VarChar(4)
  doneAt              DateTime? @map("done_at") @db.Timestamptz
  doneByUserId        String?   @map("done_by_user_id") @db.Uuid
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz
  deletedByUserId     String?   @map("deleted_by_user_id") @db.Uuid
  createdByUserId     String    @map("created_by_user_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@index([organizationId, ownerUserId, status, dueOn], map: "activity_owner_due_idx")
  @@index([organizationId, dueAt], map: "activity_due_at_idx")
  @@index([organizationId, subjectType, subjectId], map: "activity_subject_idx")
  @@index([remindAt], map: "activity_remind_idx")
  @@map("activity")
  @@schema("crm")
}

/// Lot CR.5: „Nu sunt duplicate” (S132); undone_at instead of a delete.
model DuplicateDismissal {
  id              String    @id @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  contactAId      String    @map("contact_a_id") @db.Uuid
  contactBId      String    @map("contact_b_id") @db.Uuid
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  undoneAt        DateTime? @map("undone_at") @db.Timestamptz
  undoneByUserId  String?   @map("undone_by_user_id") @db.Uuid

  contactA Contact @relation("DismissalA", fields: [contactAId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "duplicate_dismissal_contact_a_fkey")
  contactB Contact @relation("DismissalB", fields: [contactBId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "duplicate_dismissal_contact_b_fkey")

  @@map("duplicate_dismissal")
  @@schema("crm")
}

/// Lot CR.5: the log of the merges (INSERT + SELECT only).
model ContactMerge {
  id               String   @id @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  keptContactId    String   @map("kept_contact_id") @db.Uuid
  mergedContactId  String   @map("merged_contact_id") @db.Uuid
  fieldsFromMerged String[] @default([]) @map("fields_from_merged")
  createdByUserId  String   @map("created_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  kept   Contact @relation("MergeKept", fields: [keptContactId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "contact_merge_kept_fkey")
  merged Contact @relation("MergeMerged", fields: [mergedContactId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "contact_merge_merged_fkey")

  @@index([keptContactId], map: "contact_merge_kept_idx")
  @@map("contact_merge")
  @@schema("crm")
}

model OutboxEvent {
  eventId        String    @id @map("event_id") @db.Uuid
  type           String    @db.VarChar(128)
  version        Int
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz
  organizationId String    @map("organization_id") @db.Uuid
  sourceApp      String    @map("source_app") @db.VarChar(64)
  resourceId     String    @map("resource_id") @db.VarChar(255)
  correlationId  String?   @map("correlation_id") @db.VarChar(255)
  payload        Json
  status         String    @default("pending") @db.VarChar(16)
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz
  lastError      String?   @map("last_error")
  failedAt       DateTime? @map("failed_at") @db.Timestamptz
  dispatchedAt   DateTime? @map("dispatched_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("outbox_events")
  @@schema("crm")
}

model ProcessedEvent {
  consumer       String   @db.VarChar(128)
  eventId        String   @map("event_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  processedAt    DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@id([consumer, eventId])
  @@map("processed_events")
  @@schema("crm")
}
