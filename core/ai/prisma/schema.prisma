// Schema "ai" — garda de drift (prisma migrate diff) și prisma migrate deploy.
// Runtime-ul nu folosește un client Prisma generat: tabelele se accesează prin ai_rw
// cu SET LOCAL ROLE (D-DB-1 C), ca în core/commercial.

datasource db {
  provider = "postgresql"
  schemas  = ["ai"]
}

/// Modelele AI disponibile pe platformă (gestionate de fondatori).
model Model {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                   String   @unique @db.VarChar(64)
  provider               String   @db.VarChar(32)
  providerModelId        String   @map("provider_model_id") @db.VarChar(128)
  displayName            String   @map("display_name") @db.VarChar(128)
  maxInputTokens         Int      @map("max_input_tokens")
  maxOutputTokens        Int      @map("max_output_tokens")
  costPerInputTokenRon   Decimal  @map("cost_per_input_token_ron") @db.Decimal(12, 10)
  costPerOutputTokenRon  Decimal  @map("cost_per_output_token_ron") @db.Decimal(12, 10)
  enabled                Boolean  @default(true)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("models")
  @@schema("ai")
}

/// Prompturile de sistem, configurabile per organizație (null = implicit platformă).
model SystemPrompt {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String?   @map("organization_id") @db.Uuid
  applicationId   String    @map("application_id") @db.VarChar(64)
  promptKey       String    @map("prompt_key") @db.VarChar(128)
  modelSlug       String    @map("model_slug") @db.VarChar(64)
  content         String
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@unique([organizationId, applicationId, promptKey])
  @@map("system_prompts")
  @@schema("ai")
}

/// Înregistrări de consum AI (append-only).
model UsageRecord {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  applicationId   String   @map("application_id") @db.VarChar(64)
  userId          String   @map("user_id") @db.Uuid
  modelSlug       String   @map("model_slug") @db.VarChar(64)
  promptKey       String   @map("prompt_key") @db.VarChar(128)
  inputTokens     Int      @map("input_tokens")
  outputTokens    Int      @map("output_tokens")
  costRon         Decimal  @map("cost_ron") @db.Decimal(10, 6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([organizationId, createdAt])
  @@map("usage_records")
  @@schema("ai")
}

/// Plafoane de cost: global (organization_id IS NULL) și per organizație.
model CostLimit {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String?   @map("organization_id") @db.Uuid
  period          String    @default("month") @db.VarChar(16)
  limitRon        Decimal   @map("limit_ron") @db.Decimal(10, 2)
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  @@unique([organizationId, period])
  @@map("cost_limits")
  @@schema("ai")
}
