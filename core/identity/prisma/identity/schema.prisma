generator client {
  provider = "prisma-client-js"
  output   = "../../generated/identity-client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["identity"]
}

model User {
  id            String  @id
  name          String
  email         String  @unique
  emailVerified Boolean @map("email_verified")
  image         String?

  createdAt DateTime @map("created_at") @db.Timestamptz
  updatedAt DateTime @map("updated_at") @db.Timestamptz

  twoFactorEnabled Boolean? @map("two_factor_enabled")

  // Lot 2.6 · F: „Deschide direct ultima afacere data viitoare”
  openLastOrganization Boolean @default(false) @map("open_last_organization")

  sessions   Session[]
  accounts   Account[]
  twoFactors TwoFactor[]
  preference UserPreference?

  @@map("users")
  @@schema("identity")
}

model UserPreference {
  userId    String   @id @map("user_id")
  // Lot 4.3: limba notificărilor (D4-8); CHECK-ul cu cele 6 limbi e în migrare
  locale    String?  @db.VarChar(2)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preference")
  @@schema("identity")
}

// Lot 5.10c: the module's outbox (outboxMigrationSql('identity', 'identity_rw'), like organizations)
model OutboxEvent {
  eventId        String    @id @map("event_id") @db.Uuid
  type           String    @db.VarChar(128)
  version        Int
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz
  organizationId String    @map("organization_id") @db.Uuid
  sourceApp      String    @map("source_app") @db.VarChar(64)
  resourceId     String    @map("resource_id") @db.VarChar(255)
  correlationId  String?   @map("correlation_id") @db.VarChar(255)
  payload        Json
  status         String    @default("pending") @db.VarChar(16)
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz
  lastError      String?   @map("last_error")
  failedAt       DateTime? @map("failed_at") @db.Timestamptz
  dispatchedAt   DateTime? @map("dispatched_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("outbox_events")
  @@schema("identity")
}

// The consumers' idempotency (D4-1 = a).
model ProcessedEvent {
  consumer       String   @db.VarChar(128)
  eventId        String   @map("event_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  processedAt    DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@id([consumer, eventId])
  @@map("processed_events")
  @@schema("identity")
}

model Session {
  id                   String   @id
  expiresAt            DateTime @map("expires_at") @db.Timestamptz
  token                String   @unique
  createdAt            DateTime @map("created_at") @db.Timestamptz
  updatedAt            DateTime @map("updated_at") @db.Timestamptz
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  userId               String   @map("user_id")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid

  @@map("sessions")
  @@schema("identity")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz

  @@map("accounts")
  @@schema("identity")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  createdAt  DateTime? @map("created_at") @db.Timestamptz
  updatedAt  DateTime? @map("updated_at") @db.Timestamptz

  @@map("verifications")
  @@schema("identity")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @map("user_id")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(false)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz

  @@map("two_factors")
  @@schema("identity")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int    @default(0)
  lastRequest Float  @map("last_request")

  @@map("rate_limit")
  @@schema("identity")
}
