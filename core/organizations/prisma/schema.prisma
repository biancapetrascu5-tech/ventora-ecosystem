generator client {
  provider = "prisma-client-js"
  output   = "../generated/organizations-client"
}

datasource db {
  provider = "postgresql"
  schemas  = ["organizations"]
}

enum MembershipRole {
  owner
  admin
  member
  external_collaborator

  @@schema("organizations")
}

enum MembershipStatus {
  active
  suspended

  @@schema("organizations")
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked

  @@schema("organizations")
}

enum InvitationEmailStatus {
  pending
  sent
  failed

  @@schema("organizations")
}

// Lot 2.8 (D3-20): o afacere suspendată nu mai are intrare pentru nimeni din ea; datele rămân.
enum OrganizationStatus {
  active
  suspended

  @@schema("organizations")
}

enum CreatedVia {
  founder
  self_service
  import

  @@schema("organizations")
}

model Organization {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                 String             @unique @db.VarChar(63)
  name                 String             @db.VarChar(255)
  createdVia           CreatedVia         @map("created_via")
  createdByFounderId   String?            @map("created_by_founder_id") @db.Uuid
  status               OrganizationStatus @default(active)
  suspendedAt          DateTime?          @map("suspended_at") @db.Timestamptz
  suspendedByFounderId String?            @map("suspended_by_founder_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  settings    OrganizationSetting[]
  memberships Membership[]
  invitations Invitation[]

  @@map("organization")
  @@schema("organizations")
}

model OrganizationSetting {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.VarChar(128)
  value          String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("organization_setting")
  @@schema("organizations")
}

model Membership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(active)
  // Lot 2.6 · F: ultima deschidere a afacerii (HubChooseBusiness)
  lastOpenedAt   DateTime?        @map("last_opened_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("membership")
  @@schema("organizations")
}

model Invitation {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String                @map("organization_id") @db.Uuid
  organizationName   String                @map("organization_name") @db.VarChar(255)
  invitedByUserId    String                @map("invited_by_user_id") @db.Uuid
  invitedByName      String                @map("invited_by_name") @db.VarChar(255)
  email              String                @db.VarChar(255)
  role               MembershipRole
  tokenHash          String                @unique @map("token_hash") @db.VarChar(64)
  expiresAt          DateTime              @map("expires_at") @db.Timestamptz
  status             InvitationStatus      @default(pending)
  emailStatus        InvitationEmailStatus @default(pending) @map("email_status")
  acceptedByUserId   String?               @map("accepted_by_user_id") @db.Uuid
  applicationIds     String[]              @default([]) @map("application_ids") @db.VarChar(64)
  // Lot 2.6 · E: „Cere o invitație nouă” din invitația expirată
  newLinkRequestedAt DateTime?             @map("new_link_requested_at") @db.Timestamptz
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([organizationId, status])
  @@map("invitation")
  @@schema("organizations")
}

// Lot 4.1: outbox-ul modulului, din outboxMigrationSql('organizations', 'org_rw') (@ventora/db-kit).
// Indecșii parțiali (pending, dead), constrângerile CHECK, RLS și funcțiile outbox_pending /
// outbox_dead_letters există doar în migrare. Se scrie doar cu writeOutboxEvent.
model OutboxEvent {
  eventId        String    @id @map("event_id") @db.Uuid
  type           String    @db.VarChar(128)
  version        Int
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz
  organizationId String    @map("organization_id") @db.Uuid
  sourceApp      String    @map("source_app") @db.VarChar(64)
  resourceId     String    @map("resource_id") @db.VarChar(255)
  correlationId  String?   @map("correlation_id") @db.VarChar(255)
  payload        Json
  status         String    @default("pending") @db.VarChar(16)
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz
  lastError      String?   @map("last_error")
  failedAt       DateTime? @map("failed_at") @db.Timestamptz
  dispatchedAt   DateTime? @map("dispatched_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("outbox_events")
  @@schema("organizations")
}

// Idempotența consumatorilor (D4-1 = a).
model ProcessedEvent {
  consumer       String   @db.VarChar(128)
  eventId        String   @map("event_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  processedAt    DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@id([consumer, eventId])
  @@map("processed_events")
  @@schema("organizations")
}
