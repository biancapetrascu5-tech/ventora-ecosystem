{
  "name": "@ventora/organizations",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "postinstall": "prisma generate --config prisma7.config.ts",
    "generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@prisma/client-runtime-utils": "^7.10.1",
    "@ventora/audit": "workspace:*",
    "@ventora/errors": "workspace:*",
    "@ventora/notifications": "workspace:*",
    "pg": "^8.0.0",
    "prisma": "^7.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.0.0",
    "typescript": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
