// Schema "support" (Lot 4.6) — folosită pentru garda de drift (prisma migrate diff) și
// prisma migrate deploy. Codul nu folosește un client Prisma generat (ca în core/files): rulează pe
// pg, cu SET LOCAL ROLE support_rw (Hub) sau support_founder (Founder).
// CHECK-urile, triggerele, rolurile, grant-urile, RLS și funcțiile sunt doar în migrare.

datasource db {
  provider = "postgresql"
  schemas  = ["support"]
}

/// O solicitare de suport a unei afaceri (brief §39, D4-13 = a).
model SupportRequest {
  id                String    @id @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  refNumber         BigInt    @default(autoincrement()) @map("ref_number")
  ref               String    @db.VarChar(32)
  applicationId     String    @map("application_id") @db.VarChar(64)
  requesterUserId   String    @map("requester_user_id") @db.Uuid
  requesterName     String    @map("requester_name") @db.VarChar(255)
  subject           String    @db.VarChar(200)
  description       String
  urgency           String    @default("normal") @db.VarChar(16)
  status            String    @default("open") @db.VarChar(24)
  assigneeFounderId String?   @map("assignee_founder_id") @db.Uuid
  assigneeName      String?   @map("assignee_name") @db.VarChar(255)
  responseDueAt     DateTime? @map("response_due_at") @db.Timestamptz
  autoCloseAt       DateTime? @map("auto_close_at") @db.Timestamptz
  autoCloseWarnedAt DateTime? @map("auto_close_warned_at") @db.Timestamptz
  lastMessageAt     DateTime  @default(now()) @map("last_message_at") @db.Timestamptz
  lastMessageBy     String    @default("business") @map("last_message_by") @db.VarChar(16)
  lastMessageName   String    @map("last_message_name") @db.VarChar(255)
  closedAt          DateTime? @map("closed_at") @db.Timestamptz
  closedByType      String?   @map("closed_by_type") @db.VarChar(16)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  messages     SupportMessage[]
  statusEvents SupportStatusEvent[]

  @@unique([ref], map: "support_request_ref_key")
  @@unique([refNumber], map: "support_request_ref_number_key")
  @@index([organizationId, requesterUserId, lastMessageAt], map: "support_request_organization_id_requester_idx")
  @@index([status, lastMessageAt], map: "support_request_status_last_message_idx")
  @@map("support_request")
  @@schema("support")
}

/// Un mesaj din firul solicitării: al afacerii (business) sau al echipei (team).
model SupportMessage {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  authorType     String   @map("author_type") @db.VarChar(16)
  authorId       String   @map("author_id") @db.Uuid
  authorName     String   @map("author_name") @db.VarChar(255)
  body           String
  kind           String   @default("message") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  request     SupportRequest      @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  attachments SupportAttachment[]

  @@index([requestId, createdAt], map: "support_message_request_id_created_at_idx")
  @@map("support_message")
  @@schema("support")
}

/// Un fișier (core/files) atașat unui mesaj.
model SupportAttachment {
  messageId      String   @map("message_id") @db.Uuid
  fileId         String   @unique(map: "support_attachment_file_id_key") @map("file_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  message SupportMessage @relation(fields: [messageId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([messageId, fileId])
  @@map("support_attachment")
  @@schema("support")
}

/// Istoricul stării solicitării.
model SupportStatusEvent {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  kind           String   @db.VarChar(24)
  statusFrom     String?  @map("status_from") @db.VarChar(24)
  statusTo       String   @map("status_to") @db.VarChar(24)
  actorType      String   @map("actor_type") @db.VarChar(16)
  actorId        String?  @map("actor_id") @db.Uuid
  actorName      String?  @map("actor_name") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  request SupportRequest @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([requestId, createdAt], map: "support_status_event_request_id_created_at_idx")
  @@map("support_status_event")
  @@schema("support")
}

model OutboxEvent {
  eventId        String    @id @map("event_id") @db.Uuid
  type           String    @db.VarChar(128)
  version        Int
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz
  organizationId String    @map("organization_id") @db.Uuid
  sourceApp      String    @map("source_app") @db.VarChar(64)
  resourceId     String    @map("resource_id") @db.VarChar(255)
  correlationId  String?   @map("correlation_id") @db.VarChar(255)
  payload        Json
  status         String    @default("pending") @db.VarChar(16)
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz
  lastError      String?   @map("last_error")
  failedAt       DateTime? @map("failed_at") @db.Timestamptz
  dispatchedAt   DateTime? @map("dispatched_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("outbox_events")
  @@schema("support")
}

model ProcessedEvent {
  consumer       String   @db.VarChar(128)
  eventId        String   @map("event_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  processedAt    DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@id([consumer, eventId])
  @@map("processed_events")
  @@schema("support")
}
